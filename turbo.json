{
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"dependsOn": ["db:gen"],
			"cache": false,
			"persistent": true
		},
		"db:gen": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"ingest": {
			"dependsOn": ["db:gen"],
			"outputs": ["data/proccessed/**"]
		}
	}
}
