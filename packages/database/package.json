{
	"name": "@ate-a-falha/database",
	"version": "1.0.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "npm run db:generate && tsc -b && shx mkdir -p dist/generated && shx cp -r src/generated/* dist/generated/",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:studio": "prisma studio --browser none --port 51212",
		"db:seed": "prisma db seed",
		"db:seed:user": "tsx src/seeds/user.seed.ts"
	},
	"dependencies": {
		"@ate-a-falha/shared": "*",
		"@prisma/adapter-pg": "^7.6.0",
		"@prisma/client": "^7.6.0",
		"pg": "^8.13.0",
		"prisma": "^7.6.0",
		"shx": "^0.4.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.2",
		"@types/pg": "^8.11.0",
		"dotenv": "^17.3.1",
		"tsx": "^4.19.0"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module"
}
