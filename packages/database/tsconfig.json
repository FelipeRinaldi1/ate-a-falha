{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@ate-a-falha/shared": [
				"../shared/src/index.ts"
			]
		}
	},
	"references": [
		{
			"path": "../shared"
		}
	],
	"include": [
		"src/**/*"
	]
}