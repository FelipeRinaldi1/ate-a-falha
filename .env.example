# ------------------------------------------------------------------------------
# INFRASTRUCTURE (Ports & Docker)
# ------------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=3333

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="mysecretpassword"
POSTGRES_DB="ate_a_falha_db"

# Internal URL for the API to connect to the DB container
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
SERVER_URL="http://localhost:${API_PORT}"
JWT_SECRET="your_random_secret_here"
JWT_EXPIRES_IN="1d"
LOG_LEVEL="debug"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# CORS_ORIGIN: Who can talk to the backend
CORS_ORIGIN="http://localhost:${WEB_PORT}"

# VITE_API_URL: Where the frontend should send requests
VITE_API_URL="http://localhost:${API_PORT}"