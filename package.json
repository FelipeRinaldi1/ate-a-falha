{
	"name": "ate-a-falha",
	"version": "1.0.0",
	"description": "Sistema de Gerenciamento de Dietas e Treinos.",
	"main": "index.js",
	"private": true,
	"packageManager": "npm@11.10.1",
	"scripts": {
		"dev:api": "docker compose up -d db && npm run dev -w apps/api",
		"dev:web": "npm run dev -w apps/web",
		"db:up": "docker compose up -d db",
		"db:down": "docker compose down",
		"db:migrate": "npm run db:migrate -w @ate-a-falha/database",
		"db:seed": "npm run db:seed -w @ate-a-falha/database",
		"db:studio": "npm run db:studio -w @ate-a-falha/database",
		"build": "npm run db:generate -w @ate-a-falha/database && npm run build --workspaces --if-present",
		"data:pipeline": "docker compose run --rm -v ./pipeline:/app pipeline",
		"test": "npm run test -w apps/api -- --run",
		"lint": "npm run lint --workspaces --if-present",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"eslint": "^9.0.0",
		"prettier": "^3.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FelipeRinaldi1/ate-a-falha.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"bugs": {
		"url": "https://github.com/FelipeRinaldi1/ate-a-falha/issues"
	},
	"homepage": "https://github.com/FelipeRinaldi1/ate-a-falha#readme",
	"workspaces": [
		"packages/shared",
		"packages/database",
		"apps/api",
		"apps/web"
	],
	"dependencies": {
		"dotenv-expand": "^12.0.3"
	}
}
