generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ROLE {
  USER
  ADMIN
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

enum WORKOUT_DAY {
  A
  B
  C
  D
  E
  F
}

//User Related
model User {
  id        String   @id @default(uuid())
  role      ROLE     @default(USER)
  name      String
  birthDate DateTime @db.Date
  gender    GENDER

  auth Auth?

  Diet        Diet[]
  WorkoutPlan WorkoutPlan[]
  bodyMetrics BodyMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  food      Food[]
}

model Auth {
  id       String @id @default(uuid())
  email    String @unique
  password String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyMetric {
  id String @id @default(uuid())

  weight Float
  height Int

  activityLevel Int // 1 to 7

  bodyFat    Float?
  muscleRate Float?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
}

//Nutrition Related

model Diet {
  id   String @id @default(uuid())
  name String @db.VarChar(64)

  dailyKcalGoal    Int
  dailyProteinGoal Int
  dailyCarbGoal    Int
  dailyFatGoal     Int
  dailyWaterGoal   Int

  user   User   @relation(fields: [userId], references: [id])
  userId String

  Meal Meal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meal {
  id         String @id @default(uuid())
  name       String @db.VarChar(64)
  time       String
  orderIndex Int

  diet   Diet   @relation(fields: [dietId], references: [id], onDelete: Cascade)
  dietId String

  foods FoodInMeal[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model FoodInMeal {
  id       String @id @default(uuid())
  quantity Int

  meal   Meal   @relation(fields: [mealId], references: [id])
  mealId String

  food   Food   @relation(fields: [foodId], references: [id])
  foodId String

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model Food {
  id   String @id @default(uuid())
  name String @db.VarChar(64)

  baseUnit   String @default("g") // "g","ml","un",serving
  baseAmount Int    @default(100)

  calories     Int
  carbohydrate Int
  protein      Int
  fat          Int
  fiber        Int?

  usedInMeals FoodInMeal[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

//Workout Related

model WorkoutPlan {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  workouts Workout[]

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workout {
  id   String      @id @default(uuid())
  name String?
  day  WORKOUT_DAY

  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  workoutPlanId String

  workoutExercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkoutExercise {
  id         String @id @default(uuid())
  orderIndex Int

  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId String

  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId String

  sets WorkoutSet[]

  @@index([workoutId])
}

model WorkoutSet {
  id              String @id @default(uuid())
  setNumber       Int
  repetitions     Int
  weight          Float?
  restTimeSeconds Int

  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  workoutExerciseId String
}

model Exercise {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  imageUrl    String?

  usedInWorkouts WorkoutExercise[]
}
