generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

enum WorkoutDay {
  A
  B
  C
  D
  E
  F
}

//User Related
model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  Diet           Diet[]
  WorkoutRoutine WorkoutRoutine[]
  UserMetrics    UserMetrics[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model UserMetrics {
  id            String   @id @default(uuid())
  birth         DateTime @db.Date
  weight        Int
  height        Int
  gender        GENDER
  activityLevel Int // 1 to 7

  user    User   @relation(fields: [user_id], references: [id])
  user_id String @unique

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

//Nutrition Related

model DietGoal {
  id           String @id @default(uuid())
  carbohydrate Int
  protein      Int
  fat          Int
  fiber        Int
  water        Int

  diet   Diet   @relation(fields: [dietId], references: [id])
  dietId String @unique

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model Diet {
  id        String @id @default(uuid())
  name      String @db.VarChar(64)
  dailyKcal Int

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  Meal Meal[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  dietGoal DietGoal?
}

model Meal {
  id   String   @id @default(uuid())
  name String   @db.VarChar(64)
  time DateTime

  diet   Diet   @relation(fields: [dietId], references: [id])
  dietId String

  FoodInMeal FoodInMeal[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model Food {
  id           String @id @default(uuid())
  name         String @db.VarChar(64)
  carbohydrate Float
  protein      Float
  fat          Float
  fiber        Float

  FoodInMeal FoodInMeal[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model FoodInMeal {
  id              String @id @default(uuid())
  quantityPer100g Float

  meal   Meal   @relation(fields: [mealId], references: [id])
  mealId String
  food   Food   @relation(fields: [foodId], references: [id])
  foodId String

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

//Workout Related

model Exercise {
  id          String @id @default(uuid())
  name        String @db.VarChar(64)
  description String @db.Text

  setInExercise SetInExercise[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model Set {
  id          String @id @default(uuid())
  load        Int
  repetitions Int
  restTime    Int

  SetInExercise SetInExercise[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model SetInExercise {
  setInExerciseId String @id @default(uuid())

  Workout   Workout? @relation(fields: [workoutId], references: [id])
  workoutId String?

  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId String

  set   Set    @relation(fields: [setId], references: [id])
  setId String

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model Workout {
  id  String     @id @default(uuid())
  day WorkoutDay

  setInExercise SetInExercise[]

  WorkoutRoutine WorkoutRoutine? @relation(fields: [workoutRoutine], references: [id])
  workoutRoutine String?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model WorkoutRoutine {
  id   String @id @default(uuid())
  name String @db.VarChar(64)

  user   User   @relation(fields: [userId], references: [id])
  userId String

  Workouts Workout[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}
